enum LoanOriginationStage {
  APP_STARTED
  APP_SUBMITTED
  INITIAL_REVIEW
  PROCESSING
  SUBMITTED_TO_UW
  CONDITIONAL_APPROVAL
  CONDITIONS_OUTSTANDING
  CLEAR_TO_CLOSE
  APPROVED
  DENIED
  WITHDRAWN
  FUNDED
  CLOSED
}

/// LOS function on a loan file. Maps onto existing User.Role; is NOT a new Role enum value.
enum LoanStaffAssignmentType {
  LOAN_OFFICER
  PROCESSOR
  UNDERWRITER
}

/// PTD = prior to docs (decision package). PTC = prior to closing. PTF = prior to funding.
enum ConditionTiming {
  PTD
  PTC
  PTF
}

enum ConditionStatus {
  OPEN
  REQUESTED
  RECEIVED
  REVIEWED
  CLEARED
  WAIVED
  REJECTED
}

enum UnderwritingDecisionKind {
  CONDITIONAL_APPROVE
  APPROVE
  DENY
  SUSPEND
}

enum AppraisalOrderStatus {
  NOT_ORDERED
  ORDERED
  SCHEDULED
  RECEIVED
  REVIEWED
  WAIVED
  CANCELED
}

/// Guideline *placeholders*. Conventional 28/36 are DEFAULTS Charles can change.
/// Do not treat a selected set as agency approval or investor sign-off.
enum GuidelineSetKind {
  CONVENTIONAL
  FHA
  VA
  USDA
  PORTFOLIO
  OTHER
}

enum LosAutomationEventType {
  LOAN_APP_STARTED
  LOAN_APP_SUBMITTED
  LOAN_STAGE_CHANGED
  LOAN_ASSIGNED
  CONDITION_OPENED
  CONDITION_REQUESTED
  CONDITION_RECEIVED
  CONDITION_CLEARED
  CONDITION_WAIVED
  CONDITION_REJECTED
  ACTION_PLAN_UPDATED
  QUALIFICATION_COMPUTED
  UW_DECISION_RECORDED
  UW_PRODUCTION_GATE_PENDING
  UW_PRODUCTION_GATE_RELEASED
  DOCUMENT_ATTACHED
  APPRAISAL_STUB_UPDATED
  READINESS_TRACK_UPDATED
  GHL_STUB
  DISPUTEFOX_STUB
  DPA_SELECTED
}

/// Singleton-style org licensing row. Seed EMPTY. Never invent NMLS IDs.
model LenderOrgSettings {
  id              String     @id @default(cuid())
  /// Individual NMLS if/when licensed. Optional. Default null.
  nmlsId          String?
  /// Company NMLS if/when licensed. Optional. Default null.
  companyNmls     String?
  /// JSON array of US state codes, e.g. []. Empty by default.
  licensedStates  Json
  dbaName         String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  loanFiles       LoanFile[]
}

/// One origination file per MortgageApplication. Ratios stored as bps (28.00% = 2800).
/// Money stored as integer cents. noteRateBps: 6.500% = 650.
model LoanFile {
  id                   String                @id @default(cuid())
  applicationId        String                @unique
  /// Internal file number (e.g. GC-LN-000001 via IdSequence). NOT an NMLS id.
  loanNumber           String                @unique
  purpose              LoanPurposeKind       @default(PURCHASE)
  purchasePriceCents   Int?
  appraisedValueCents  Int?
  loanAmountCents      Int?
  noteRateBps          Int?
  termMonths           Int?
  occupancy            OccupancyKind?
  ltvBps               Int?
  cltvBps              Int?
  frontDtiBps          Int?
  backDtiBps           Int?
  reservesMonths       Int?
  guidelineSet         GuidelineSetKind      @default(CONVENTIONAL)
  nmlsConfigId         String?
  originationStage     LoanOriginationStage  @default(APP_STARTED)
  /// DPA $1,800 add-on. Amount is 180000 cents when selected; 0 otherwise.
  dpaSelected          Boolean               @default(false)
  dpaAmountCents       Int                   @default(0)
  dpaSelectedAt        DateTime?
  paymentAcknowledged  Boolean               @default(false)
  paymentAcknowledgedAt DateTime?
  agreementVersion     String                @default("2026-08-23-cognito-derived-draft-v1")
  servicePackageAmountCents Int              @default(0)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  application          MortgageApplication   @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  nmlsConfig           LenderOrgSettings?    @relation(fields: [nmlsConfigId], references: [id], onDelete: SetNull)

  @@index([originationStage])
  @@index([loanNumber])
  @@index([nmlsConfigId])
}

model LoanStageEvent {
  id              String                @id @default(cuid())
  applicationId   String
  fromStage       LoanOriginationStage?
  toStage         LoanOriginationStage
  actorUserId     String?
  reason          String?
  createdAt       DateTime              @default(now())
  application     MortgageApplication   @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  @@index([applicationId, createdAt])
  @@index([toStage])
}

/// Seed catalog (VOE, VOD, VOI, tax transcripts, ID, insurance, appraisal, title, HOI,
/// credit-repair completion, Credit Hero, MyFICO). Codes are stable; labels Charles-editable.
model ConditionCatalogItem {
  id              String           @id @default(cuid())
  code            String           @unique
  label           String
  timingDefault   ConditionTiming  @default(PTD)
  borrowerOwned   Boolean          @default(false)
  requiresUpload  Boolean          @default(true)
  processorCanClear Boolean        @default(false)
  active          Boolean          @default(true)
  sortOrder       Int              @default(0)
  conditions      LoanCondition[]
}

model LoanCondition {
  id              String                 @id @default(cuid())
  applicationId   String
  catalogItemId   String?
  code            String
  title           String
  timing          ConditionTiming        @default(PTD)
  status          ConditionStatus        @default(OPEN)
  borrowerOwned   Boolean                @default(false)
  dueAt           DateTime?
  requestedAt     DateTime?
  receivedAt      DateTime?
  reviewedAt      DateTime?
  clearedAt       DateTime?
  waivedAt        DateTime?
  rejectedAt      DateTime?
  notes           String?
  documentId      String?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  application     MortgageApplication    @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  catalogItem     ConditionCatalogItem?  @relation(fields: [catalogItemId], references: [id], onDelete: SetNull)
  document        Document?              @relation(fields: [documentId], references: [id], onDelete: SetNull)
  actionPlanItems ActionPlanItem[]
  @@index([applicationId, status])
  @@index([applicationId, timing])
  @@index([borrowerOwned, status])
}

/// Borrower action plan = the set of OPEN/REQUESTED conditions the borrower must complete.
model BorrowerActionPlan {
  id              String               @id @default(cuid())
  applicationId   String
  title           String               @default("Borrower action plan")
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  application     MortgageApplication  @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  items           ActionPlanItem[]
  @@index([applicationId])
}

model ActionPlanItem {
  id              String              @id @default(cuid())
  planId          String
  conditionId     String
  label           String
  done            Boolean             @default(false)
  doneAt          DateTime?
  plan            BorrowerActionPlan  @relation(fields: [planId], references: [id], onDelete: Cascade)
  condition       LoanCondition       @relation(fields: [conditionId], references: [id], onDelete: Cascade)
  @@unique([planId, conditionId])
}

/// Frozen calc output. NEVER a credit score. NEVER the origination decision by itself.
/// Ratios in bps. Money in cents. See 16-qualification.md.
model QualificationSnapshot {
  id                         String               @id @default(cuid())
  applicationId              String
  guidelineSet               GuidelineSetKind
  monthlyQualifyingIncomeCents Int
  monthlyHousingExpenseCents Int
  monthlyTotalDebtCents      Int
  loanAmountCents            Int
  purchasePriceCents         Int?
  appraisedValueCents        Int?
  subordinateLienCents       Int                 @default(0)
  liquidAssetCents           Int
  frontDtiBps                Int
  backDtiBps                 Int
  ltvBps                     Int?
  cltvBps                    Int?
  reservesMonths             Int?
  frontLimitBps              Int
  backLimitBps               Int
  withinFront                Boolean
  withinBack                 Boolean
  inputsHash                 String
  computedAt                 DateTime            @default(now())
  application                MortgageApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  @@index([applicationId, computedAt])
}

/// Software has APPROVE/DENY. Production commit requires Charles until he lifts the gate.
model UnderwritingDecision {
  id                      String                    @id @default(cuid())
  applicationId           String
  kind                    UnderwritingDecisionKind
  actorUserId             String
  rationale               String?
  productionGateRequired  Boolean                   @default(true)
  productionReleased      Boolean                   @default(false)
  charlesApprovedAt       DateTime?
  charlesApprovedById     String?
  createdAt               DateTime                  @default(now())
  application             MortgageApplication       @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  actor                   User                      @relation("UwDecisionActor", fields: [actorUserId], references: [id], onDelete: Restrict)
  charlesApprover         User?                     @relation("CharlesUwGate", fields: [charlesApprovedById], references: [id], onDelete: SetNull)
  @@index([applicationId, createdAt])
}

/// Stub only in milestone 1. No AMC integration.
model AppraisalOrder {
  id              String                @id @default(cuid())
  applicationId   String
  status          AppraisalOrderStatus  @default(NOT_ORDERED)
  orderedAt       DateTime?
  receivedAt      DateTime?
  valueCents      Int?
  notes           String?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  application     MortgageApplication   @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  @@index([applicationId, status])
}

model ProcessingChecklistItem {
  id              String               @id @default(cuid())
  applicationId   String
  code            String
  label           String
  done            Boolean              @default(false)
  doneAt          DateTime?
  doneById        String?
  sortOrder       Int                  @default(0)
  createdAt       DateTime             @default(now())
  application     MortgageApplication  @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  @@unique([applicationId, code])
  @@index([applicationId, done])
}

/// Grants proprietary overlay. score 0-100 is INTERNAL, not the origination decision,
/// not a credit score, not a substitute for QualificationSnapshot.
model GrantsReadinessTrack {
  id              String               @id @default(cuid())
  applicationId   String               @unique
  creditReady     Boolean              @default(false)
  docsReady       Boolean              @default(false)
  prepReady       Boolean              @default(false)
  score           Int                  @default(0)
  notes           String?
  updatedAt       DateTime             @updatedAt
  application     MortgageApplication  @relation(fields: [applicationId], references: [id], onDelete: Cascade)
}

/// Domain event log for LOS automation. Sprint 1: persist only. No live GHL writes.
model LosAutomationEvent {
  id              String                  @id @default(cuid())
  applicationId   String?
  type            LosAutomationEventType
  payloadJson     String
  status          String                  @default("RECORDED")
  createdAt       DateTime                @default(now())
  @@index([type, createdAt])
  @@index([applicationId, createdAt])
}


enum ApplicationSectionCode {
  COMPLIANCE
  BORROWER
  CO_BORROWER
  EMPLOYMENT
  ASSETS
  LIABILITIES
  REO
  LOAN
  DECLARATIONS
  DOCUMENTS
}

enum ApplicationSectionStatus {
  EMPTY
  IN_PROGRESS
  COMPLETE
  BLOCKED
}

/// Save/resume. LoanFile.originationStage remains operational truth.
model ApplicationSectionState {
  id              String                   @id @default(cuid())
  applicationId   String
  /// Empty string for loan-level sections (COMPLIANCE, LOAN, DOCUMENTS).
  borrowerKey     String                   @default("")
  section         ApplicationSectionCode
  status          ApplicationSectionStatus @default(EMPTY)
  lastSavedAt     DateTime?
  errorsJson      String                   @default("[]")
  application     MortgageApplication      @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  @@unique([applicationId, borrowerKey, section])
  @@index([applicationId, status])
}

/// URLA two-year housing history. Current address: endOn = null.
model BorrowerAddressHistory {
  id                 String             @id @default(cuid())
  borrowerId         String
  street             String
  line2              String?
  city               String
  state              String
  zip                String
  startOn            DateTime
  endOn              DateTime?
  housingTenure      HousingTenureKind
  monthlyRentCents   Int?
  isMailing          Boolean            @default(false)
  sortOrder          Int                @default(0)
  borrower           MortgageBorrower   @relation(fields: [borrowerId], references: [id], onDelete: Cascade)
  @@index([borrowerId, endOn])
}
