// =============================================================================
// Grants & Co LOS — Prisma models to APPEND into grants-co-os
// Product: lender-style Mortgage Loan Origination System (module).
// Milestone 1 = domain/ops (entities, lifecycle, roles, calcs, documents, events).
// Append to BOTH prisma/schema.prisma (SQLite local) AND prisma/schema.postgres.prisma
// (Neon prod). prisma.config.ts already switches on DATABASE_URL.
// Do NOT recreate User, Session, StaffProfile, Client, ClientIdentifier, Document,
// AuditLog, ClientAssignment, Task, Service, ClientService, OnboardingToken.
// 71 models already exist. ONE HUMAN = ONE Client.
// URLA borrower models below are the application DATA STRUCTURE. Keep them.
// LOS workflow models are APPENDED after the URLA block.
//
// PATCH existing models (manual, not duplicated here):
//   enum Role  — do NOT add LOAN_OFFICER / PROCESSOR / UNDERWRITER to Role.
//                Those are LoanStaffAssignmentType on MortgageStaffAssignment.
//                Agent-service auth uses Agent Hub / bearer, not a User row.
//   model Client {
//     mortgageApplications MortgageApplication[]
//     ssnVaults            SsnVault[]
//   }
//   model User {
//     mortgageAssignments  MortgageStaffAssignment[]
//     mortgageNotes        MortgageApplicationNote[]
//     mortgageAuditEvents  MortgageAuditEvent[] @relation("MortgageAuditActor")
//     underwritingDecisions UnderwritingDecision[] @relation("UwDecisionActor")
//     charlesUwGates       UnderwritingDecision[] @relation("CharlesUwGate")
//   }
//   model Document {
//     mortgageFiles        MortgageDocumentFile[]
//     loanConditionDocs    LoanCondition[]
//   }
//   prisma/seed.ts — insert Service { code: "MORTGAGE_LOS", name: "Mortgage Loan Origination" }
//                    Do not overload CREDIT_OPT. Do not invent an NMLS number.
//   LenderOrgSettings seeds EMPTY nmlsId / companyNmls / licensedStates=[].
// =============================================================================

enum MortgagePipelineStage {
  NEW_APPLICATION
  LEGAL_AGREEMENT_COMPLETED
  APPLICATION_STARTED
  APPLICATION_SUBMITTED
  AI_REVIEW_COMPLETE
  DOCUMENTS_NEEDED
  HUMAN_REVIEW
  MORTGAGE_READY
  REFERRED_TO_LENDER
  CLOSED
}

enum MortgageQualitativeStatus {
  ON_TRACK
  NEEDS_DOCUMENTS
  IN_REVIEW
}

enum MortgageApplicationStep {
  AGREEMENT
  PROFILE
  EMPLOYMENT
  ASSETS
  LIABILITIES
  CREDIT
  PROPERTY
  DECLARATIONS
  DOCUMENTS
  REVIEW
}

enum BorrowerRoleKind {
  PRIMARY
  CO_BORROWER
}

