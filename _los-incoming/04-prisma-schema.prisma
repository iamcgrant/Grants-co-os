model MortgageApplication {
  id                      String                     @id @default(cuid())
  /// Existing Client master. ONE HUMAN = ONE Client. Never a second person row.
  clientId                String
  coBorrowerClientId      String?
  serviceCode             String                     @default("MORTGAGE_LOS")
  pipelineStage           MortgagePipelineStage      @default(NEW_APPLICATION)
  qualitativeStatus       MortgageQualitativeStatus  @default(IN_REVIEW)
  currentStep             MortgageApplicationStep    @default(AGREEMENT)
  submittedAt             DateTime?
  referredToLenderAt      DateTime?
  closedAt                DateTime?
  includeCreditRepair     Boolean?
  creditProgramPath       CreditProgramPath?
  interestedInDpa1800     Boolean                    @default(false)
  /// Client-facing free text. Not a bureau score.
  creditConcernsText      String?
  ghlContactId            String?
  ghlSyncStatus           String                     @default("STUB")
  disputeFoxClientId      String?
  legalVersionRequired    String                     @default("2026-08-23-cognito-derived-draft-v1")
  exampleData             Boolean                    @default(false)
  createdAt               DateTime                   @default(now())
  updatedAt               DateTime                   @updatedAt

  client                  Client                     @relation(fields: [clientId], references: [id], onDelete: Restrict)
  borrowers               MortgageBorrower[]
  legalAcknowledgements   LegalAcknowledgement[]
  propertyGoal            PropertyGoal?
  documents               MortgageDocumentFile[]
  aiReviews               AiReview[]
  readinessScores         ReadinessScore[]
  pipelineEvents          PipelineEvent[]
  auditEvents             MortgageAuditEvent[]
  assignments             MortgageStaffAssignment[]
  notes                   MortgageApplicationNote[]
  gifts                   MortgageGiftGrant[]
  otherAssets             MortgageOtherAsset[]
  realEstateOwned         MortgageReo[]
  loanFile                LoanFile?
  originationEvents       LoanStageEvent[]
  conditions              LoanCondition[]
  actionPlans             BorrowerActionPlan[]
  qualificationSnapshots  QualificationSnapshot[]
  underwritingDecisions   UnderwritingDecision[]
  appraisalOrders         AppraisalOrder[]
  processingChecklist     ProcessingChecklistItem[]
  readinessTrack          GrantsReadinessTrack?
  sectionStates           ApplicationSectionState[]
  complianceAcknowledgments ComplianceAcknowledgment[]

  @@index([clientId])
  @@index([pipelineStage])
  @@index([qualitativeStatus])
  @@index([ghlContactId])
}

/// Encrypted SSN vault. NEVER a plaintext ssn column. Last-4 only in UI.
model SsnVault {
  id             String   @id @default(cuid())
  clientId       String
  borrowerId     String   @unique
  ssnCiphertext  Bytes
  ssnLast4       String
  ssnKeyVersion  String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  client         Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  borrower       MortgageBorrower @relation(fields: [borrowerId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([ssnLast4])
}

model MortgageBorrower {
  id                         String               @id @default(cuid())
  applicationId              String
  clientId                   String
  roleKind                   BorrowerRoleKind     @default(PRIMARY)
  firstNameOnDl              String
  middleName                 String?
  lastNameOnDl               String
  mobilePhone                String?
  email                      String?
  workEmail                  String?
  dateOfBirth                DateTime?
  citizenshipOrResidency     CitizenshipResidency?
  militaryService            YesNoUnknown         @default(UNKNOWN)
  preferredLanguage          String?
  maritalStatus              MaritalStatusKind?
  nonSpousePropertyRights    YesNoUnknown         @default(UNKNOWN)
  dependentsCount            Int                  @default(0)
  dependentsAgesJson         String?
  currentStreet              String?
  currentLine2               String?
  currentCity                String?
  currentState               String?
  currentZip                 String?
  mailingSameAsCurrent       Boolean              @default(true)
  mailingStreet              String?
  mailingCity                String?
  mailingState               String?
  mailingZip                 String?
  yearsAtAddress             Int?
  monthsAtAddress            Int?
  ownRentOrNoRent            HousingTenureKind?
  hmdaEthnicityJson          String?
  hmdaRaceJson               String?
  hmdaGenderJson             String?
  hmdaDoNotWishToProvide     Boolean              @default(false)
  createdAt                  DateTime             @default(now())
  updatedAt                  DateTime             @updatedAt

  application                MortgageApplication  @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  ssnVault                   SsnVault?
  employments                Employment[]
  incomeSources              IncomeSource[]
  assetAccounts              AssetAccount[]
  liabilities                Liability[]
  declaration                Declaration?
  creditItems                MortgageCreditItem[]
  addressHistory              BorrowerAddressHistory[]

  @@index([applicationId])
  @@index([clientId])
  @@index([email])
}

model LegalAcknowledgement {
  id                         String   @id @default(cuid())
  applicationId              String
  documentVersion            String
  signedAt                   DateTime
  ipAddress                  String
  userAgent                  String
  signatureNameFirst         String
  signatureNameLast          String
  signatureImageKey          String?
  dateSigned                 DateTime
  agreeNotNewCredit          Boolean
  agreeNoLargePurchases      Boolean
  agreeNoAccountChanges      Boolean
  understandMayImpactApproval Boolean
  understandNonrefundable    Boolean
  understandPaymentCleared   Boolean
  understandCancelFee1800    Boolean
  understandNoChangeMind     Boolean
  interestedInDpa1800        Boolean  @default(false)
  addressConfidentiality     Boolean
  creditAuthorization        Boolean
  informationRelease         Boolean
  eSignConsent               Boolean
  agreeAllTermsProceed       Boolean
  acknowledgedTaylorCarroll  Boolean  @default(true)
  acknowledgedSeparateLenderIdentity Boolean @default(true)
  loanAuditLenderRights      Boolean  @default(false)
  acknowledgedNoGuarantees   Boolean  @default(true)
  createdAt                  DateTime @default(now())

  application                MortgageApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId, signedAt])
}

/// Named disclosures recorded independently of LegalAcknowledgement.
/// DPA_SELECTION is stored always and is not a submit blocker.
enum ComplianceDisclosureType {
  ACCOUNT_CREATION
  AGENT_ASSIGNMENT
  CREDIT_NO_NEW
  CREDIT_NO_LARGE_PURCHASES
  CREDIT_NO_ACCOUNT_CHANGES
  CREDIT_IMPACT
  PAYMENT_NONREFUNDABLE
  PAYMENT_CLEARED
  LOAN_AUDIT_LENDER_RIGHTS
  E_SIGN_CONSENT
  CREDIT_AUTHORIZATION
  INFORMATION_RELEASE
  CANCEL_FEE
  NO_CHANGE_MIND
  NO_GUARANTEES
  ALL_TERMS_PROCEED
  DPA_SELECTION
}

/// Per-disclosure acknowledgement. borrowerId is Client.id (borrower_id) until MortgageBorrower exists.
model ComplianceAcknowledgment {
  id                String                     @id @default(cuid())
  applicationId     String
  /// Client.id used as borrower_id per product owner; MortgageBorrower may not exist yet.
  borrowerId        String
  disclosureType    ComplianceDisclosureType
  acknowledged      Boolean
  agreementVersion  String                     @default("2026-08-23-cognito-derived-draft-v1")
  ipAddress         String?
  userAgent         String?
  createdAt         DateTime                   @default(now())
  application       MortgageApplication        @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@unique([applicationId, disclosureType])
  @@index([applicationId])
  @@index([borrowerId])
}

model Employment {
  id                      String               @id @default(cuid())
  borrowerId              String
  situation               EmploymentSituation
  employmentType          EmploymentTypeKind?
  employerName            String?
  employerStreet          String?
  employerCity            String?
  employerState           String?
  employerZip             String?
  employerPhone           String?
  startDate               DateTime?
  endDate                 DateTime?          // required when isCurrent=false
  yearsInLineOfWork       Int?
  monthsInLineOfWork      Int?
  relatedPartyEmployment  Boolean              @default(false)
  jobTitle                String?
  isCurrent               Boolean              @default(true)
  monthlyIncomeBeforeTaxesCents Int?
  hasOtCommissionBonus    Boolean              @default(false)
  otAmountCents           Int?
  commissionAmountCents   Int?
  bonusAmountCents        Int?
  sortOrder               Int                  @default(0)
  createdAt               DateTime             @default(now())
  updatedAt               DateTime             @updatedAt
  borrower                MortgageBorrower     @relation(fields: [borrowerId], references: [id], onDelete: Cascade)
  @@index([borrowerId])
}

model IncomeSource {
  id                 String           @id @default(cuid())
  borrowerId         String
  source             String
  monthlyAmountCents Int
  doesNotApply       Boolean          @default(false)
  createdAt          DateTime         @default(now())
  borrower           MortgageBorrower @relation(fields: [borrowerId], references: [id], onDelete: Cascade)
  @@index([borrowerId])
}

model AssetAccount {
  id                    String           @id @default(cuid())
  borrowerId            String
  institutionName       String
  accountType           AssetAccountType
  accountLast4          String
  estimatedBalanceCents Int
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt
  borrower              MortgageBorrower @relation(fields: [borrowerId], references: [id], onDelete: Cascade)
  @@index([borrowerId])
}

model Liability {
  id                  String             @id @default(cuid())
  borrowerId          String
  type                LiabilityTypeKind
  monthlyPaymentCents Int
  unpaidBalanceCents  Int
  toBePaidOff         Boolean            @default(false)
  doesNotApply        Boolean            @default(false)
  creditorName        String?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  borrower            MortgageBorrower   @relation(fields: [borrowerId], references: [id], onDelete: Cascade)
  @@index([borrowerId])
}

model MortgageGiftGrant {
  id              String               @id @default(cuid())
  applicationId   String
  source          String
  amountCents     Int
  doesNotApply    Boolean              @default(false)
  application     MortgageApplication  @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  @@index([applicationId])
}

model MortgageOtherAsset {
  id              String               @id @default(cuid())
  applicationId   String
  description     String
  amountCents     Int
  doesNotApply    Boolean              @default(false)
  application     MortgageApplication  @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  @@index([applicationId])
}

enum ReoDisposition {
  RETAIN
  SELL
  PENDING_SALE
}

model MortgageReo {
  id                        String               @id @default(cuid())
  applicationId             String
  ownOtherRealEstate        Boolean              @default(false)
  street                    String?
  city                      String?
  state                     String?
  zip                       String?
  propertyType              PropertyTypeKind?
  occupancy                 OccupancyKind?
  disposition               ReoDisposition?
  marketValueCents          Int?
  mortgageCreditor          String?
  mortgageBalanceCents      Int?
  mortgageMonthlyCents      Int?
  rentalIncomeMonthlyCents  Int?
  application               MortgageApplication  @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  @@index([applicationId])
}

model MortgageCreditItem {
  id              String                  @id @default(cuid())
  borrowerId      String
  kind            MortgageCreditItemKind
  creditorName    String?
  amountCents     Int?
  notes           String?
  createdAt       DateTime                @default(now())
  borrower        MortgageBorrower        @relation(fields: [borrowerId], references: [id], onDelete: Cascade)
  @@index([borrowerId, kind])
}

model Declaration {
  id                         String           @id @default(cuid())
  borrowerId                 String           @unique
  intendOccupyPrimary        YesNoUnknown     @default(UNKNOWN)
  ownershipInterestLast3Years YesNoUnknown    @default(UNKNOWN)
  sellerAffiliation          YesNoUnknown     @default(UNKNOWN)
  undisclosedBorrowedFunds   YesNoUnknown     @default(UNKNOWN)
  otherMortgageApplication   YesNoUnknown     @default(UNKNOWN)
  newCreditBeforeClosing     YesNoUnknown     @default(UNKNOWN)
  pacePriorityLien           YesNoUnknown     @default(UNKNOWN)
  cosignorUndisclosed        YesNoUnknown     @default(UNKNOWN)
  outstandingJudgments       YesNoUnknown     @default(UNKNOWN)
  federalDebtDefault         YesNoUnknown     @default(UNKNOWN)
  lawsuitLiability           YesNoUnknown     @default(UNKNOWN)
  deedInLieuLast7Years       YesNoUnknown     @default(UNKNOWN)
  shortSaleLast7Years        YesNoUnknown     @default(UNKNOWN)
  foreclosureLast7Years      YesNoUnknown     @default(UNKNOWN)
  bankruptcyLast7Years       YesNoUnknown     @default(UNKNOWN)
  explanationsJson           String?
  updatedAt                  DateTime         @updatedAt
  borrower                   MortgageBorrower @relation(fields: [borrowerId], references: [id], onDelete: Cascade)
}

model PropertyGoal {
  id                         String               @id @default(cuid())
  applicationId              String               @unique
  loanPurpose                LoanPurposeKind?
  estimatedPurchasePriceCents Int?
  downPaymentAmountCents     Int?
  downPaymentSource          DownPaymentSourceKind?
  loanAmountNeededCents      Int?
  propertyType               PropertyTypeKind?
  occupancy                  OccupancyKind?
  builderSubdivisionCommunity String?
  buyerBrokerAgreement       YesNoUnknown         @default(UNKNOWN)
  specificHomeSelected       YesNoUnknown         @default(UNKNOWN)
  propertyStreet             String?
  propertyCity               String?
  propertyState              String?
  propertyZip                String?
  realtorName                String?
  updatedAt                  DateTime             @updatedAt
  application                MortgageApplication  @relation(fields: [applicationId], references: [id], onDelete: Cascade)
}

/// DocumentFile. Wraps existing Document (storageKey, category). Sprint 1: metadata + storageKey.
/// No object-store adapter exists today. Preview may use local/private blob; Vercel Blob later.
model MortgageDocumentFile {
  id              String                 @id @default(cuid())
  applicationId   String
  documentId      String?
  package         MortgageDocumentPackage
  kind            String
  originalName    String
  mimeType        String
  storageKey      String
  byteSize        Int
  uploadedByRole  String
  createdAt       DateTime               @default(now())
  application     MortgageApplication    @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  document        Document?              @relation(fields: [documentId], references: [id], onDelete: SetNull)
  @@index([applicationId, package])
}

model AiReview {
  id                    String               @id @default(cuid())
  applicationId         String
  scoringVersion        String
  missingDocumentsJson  String
  missingInformationJson String
  incomeInconsistenciesJson String
  employmentConcernsJson String
  creditRiskFactorsJson String
  recommendedActionsJson String
  narrative             String?
  modelId               String?
  forbiddenLanguageHit  Boolean              @default(false)
  createdAt             DateTime             @default(now())
  application           MortgageApplication  @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  scores                ReadinessScore[]
  @@index([applicationId, createdAt])
}

/// Internal heuristic 0-100. NEVER a credit score. NEVER a loan approval.
model ReadinessScore {
  id              String               @id @default(cuid())
  applicationId   String
  aiReviewId      String?
  score           Int
  strengthsJson   String
  risksJson       String
  action          String
  visibleToClient Boolean              @default(false)
  createdAt       DateTime             @default(now())
  application     MortgageApplication  @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  aiReview        AiReview?            @relation(fields: [aiReviewId], references: [id], onDelete: SetNull)
  @@index([applicationId, createdAt])
}

model PipelineEvent {
  id              String                 @id @default(cuid())
  applicationId   String
  fromStage       MortgagePipelineStage?
  toStage         MortgagePipelineStage
  actorUserId     String?
  reason          String?
  createdAt       DateTime               @default(now())
  application     MortgageApplication    @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  @@index([applicationId, createdAt])
}

/// AuditEvent (mortgage-scoped). Also write a row to existing AuditLog with entityType MORTGAGE_APPLICATION.
model MortgageAuditEvent {
  id              String               @id @default(cuid())
  applicationId   String
  actorId         String?
  action          String
  entityType      String
  entityId        String?
  metadataJson    String?
  ipAddress       String?
  createdAt       DateTime             @default(now())
  application     MortgageApplication  @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  actor           User?                @relation("MortgageAuditActor", fields: [actorId], references: [id])
  @@index([applicationId, createdAt])
  @@index([action])
}

/// StaffAssignment for a loan file. Distinct from ClientAssignment (credit file owner).
/// assignmentType is LOS function (LO / Processor / UW), NOT a new User.Role enum value.
model MortgageStaffAssignment {
  id              String                   @id @default(cuid())
  applicationId   String
  staffId         String
  assignmentType  LoanStaffAssignmentType
  roleLabel       String?
  isPrimary       Boolean                  @default(true)
  createdAt       DateTime                 @default(now())
  application     MortgageApplication      @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  staff           User                     @relation(fields: [staffId], references: [id], onDelete: Restrict)
  @@unique([applicationId, staffId, assignmentType])
  @@index([assignmentType, applicationId])
}

model MortgageApplicationNote {
  id              String               @id @default(cuid())
  applicationId   String
  authorId        String
  body            String
  createdAt       DateTime             @default(now())
  application     MortgageApplication  @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  author          User                 @relation(fields: [authorId], references: [id], onDelete: Restrict)
  @@index([applicationId, createdAt])
}

