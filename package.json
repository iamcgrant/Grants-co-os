{
  "name": "grants-co-os",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0 --port 3000",
    "build": "node scripts/prisma-generate.mjs && next build",
    "start": "next start --hostname 0.0.0.0 --port 3000",
    "lint": "eslint",
    "db:generate": "node scripts/prisma-generate.mjs",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma migrate reset --force",
    "db:migrate:production": "bash scripts/migrate-production.sh",
    "test": "vitest run",
    "test:watch": "vitest",
    "desktop:prepare": "node scripts/prepare-desktop-shell.mjs",
    "desktop:smoke": "node scripts/desktop-smoke-check.mjs",
    "agent-mesh": "tsx agent-mesh/server.ts",
    "ghl:inbound-sync": "tsx scripts/ghl-inbound-sync.ts",
    "ghl:inbound-conversations": "tsx scripts/ghl-inbound-conversations.ts",
    "df:inbound-attach": "tsx scripts/disputefox-inbound-attach.ts",
    "clients:import-confirmed-masters": "tsx scripts/import-confirmed-masters.ts",
    "crc:recovery-report": "tsx scripts/crc-recovery-report.ts",
    "crc:inbound-compare": "tsx scripts/crc-inbound-compare.ts",
    "postinstall": "node scripts/prisma-generate.mjs",
    "commas:register-webhook": "tsx scripts/commas-register-webhook.ts",
    "deploy:production": "bash scripts/deploy-production.sh",
    "go:live": "bash scripts/go-live.sh",
    "domain:configure": "bash scripts/configure-domain.sh",
    "e2e:production": "tsx scripts/production-e2e.ts",
    "smoke:production": "tsx scripts/production-smoke.ts",
    "launch:readiness": "tsx scripts/launch-readiness.ts",
    "desktop:linux": "node scripts/prepare-desktop-shell.mjs && cd desktop && npm install && npm run build",
    "owner:setup-link": "tsx scripts/owner-setup-link.ts",
    "sbtpg:ingest-fee-summary": "tsx scripts/ingest-sbtpg-fee-summary.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@prisma/adapter-better-sqlite3": "^7.9.1",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.0.3",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "dotenv": "^17.2.1",
    "jose": "^6.2.9",
    "lucide-react": "^1.31.0",
    "nanoid": "^6.0.1",
    "next": "16.3.1",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "uuid": "^14.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20",
    "@types/pg": "^8.23.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^6.0.5",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "prisma": "^7.9.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
