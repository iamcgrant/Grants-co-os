# Grants & Co OS environment example
# Copy to .env locally. Never commit real secrets.

DATABASE_URL="file:./dev.db"
AUTH_SECRET="replace-with-long-random-secret"
PAYMENT_PROVIDER="mock"

# --- Authorize.Net (preferred primary; sandbox first) ---
# PAYMENT_PROVIDER=authorize_net
# Secret names only — never commit values. Fail-closed when unset.
# AUTHORIZE_NET_SANDBOX_API_LOGIN_ID=
# AUTHORIZE_NET_SANDBOX_TRANSACTION_KEY=
# AUTHORIZE_NET_SANDBOX_CLIENT_KEY=
# Legacy aliases (sandbox-prefixed names win when both are set):
# AUTHORIZE_NET_API_LOGIN_ID=
# AUTHORIZE_NET_TRANSACTION_KEY=
# AUTHORIZE_NET_PUBLIC_CLIENT_KEY=
# AUTHORIZE_NET_SIGNATURE_KEY=
# AUTHORIZE_NET_ENVIRONMENT=sandbox
# AUTHORIZE_NET_LIVE_CHARGES=false

# --- Commas (secondary / MoR option) ---
# PAYMENT_PROVIDER=commas
# COMMAS_API_KEY=
# COMMAS_WEBHOOK_SECRET=
# COMMAS_ENVIRONMENT=sandbox
# COMMAS_LIVE_CHARGES=false

# --- Post-payment DisputeFox intake ---
# DISPUTEFOX_INTAKE_URL_TEMPLATE=https://app.example/intake/{externalId}?ref={grantsClientId}

# --- Staff portal credentials (use Cursor Secrets / host env — never commit) ---
# GHL_LOGIN_EMAIL=
# GHL_LOGIN_PASSWORD=
# Live inbound GHL → Grants Client + inbox (existing/linked master records only).
# Required secret (host/runtime / Cursor Secrets — never commit the value):
# GHL_API_KEY=
# Location id is also a secret (host/runtime / Cursor Secrets — never commit the value):
# GHL_LOCATION_ID=
# Conversation pull is read-only. If the PIT is contacts.readonly only, it fail-closes
# until X1 adds conversations.readonly (and conversations/message.readonly for bodies).
# DISPUTEFOX_LOGIN_EMAIL=
# DISPUTEFOX_LOGIN_PASSWORD=
# Live inbound DisputeFox → Grants Client (existing master records only).
# Required secret name for the live path (host/runtime / Cursor Secrets — never commit the value).
# Fail-closed when unset. Do not regenerate the Fox API key. Zap 374413762 stays OFF.
# DISPUTEFOX_API_KEY=

# --- Agent Hub → Cursor Cloud Agents (bots launch Cursor) ---
# Prefer AGENT_HUB_CURSOR_API_KEY on Cloud Agent VMs: names starting with
# CURSOR_ are reserved and often never injected. Never commit the value.
# AGENT_HUB_CURSOR_API_KEY=
# CURSOR_API_KEY=
# AGENT_HUB_CURSOR_STARTING_REF=main
# AGENT_HUB_CURSOR_REPO_URL=https://github.com/iamcgrant/Grants-co-os

# --- SmartCredit sponsored enrollment (required for affiliate payouts) ---
# Public partner join link (pid preserves your payout attribution):
# SMARTCREDIT_SPONSOR_URL=https://www.smartcredit.com/join/?pid=YOUR_PID
# SMARTCREDIT_SPONSOR_CODE=

# --- CRC contact recovery (identify + dry-run only) ---
# Default fail-closed. Live GHL/DisputeFox writes are refused even when true.
# CRC_RECOVERY_WRITES_ENABLED=false
