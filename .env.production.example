# Grants & Co OS — production environment template
# Copy values into Vercel Project → Settings → Environment Variables (Production).
# Never commit real secrets. Exact names match repository source (docs/PRODUCTION_ENV.md).

# --- Core (required) ---
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/neondb?sslmode=require
AUTH_SECRET=GENERATE_WITH_openssl_rand_base64_48
GC_CRON_SECRET=GENERATE_WITH_openssl_rand_base64_48
# Vercel Cron also accepts Authorization: Bearer $CRON_SECRET — set equal to GC_CRON_SECRET
CRON_SECRET=SAME_AS_GC_CRON_SECRET
NEXT_PUBLIC_APP_URL=https://os.grantsandco.com
GC_ENV=production
GC_DESKTOP_URL=https://os.grantsandco.com

# --- Payments (Commas primary) ---
PAYMENT_PROVIDER=commas
COMMAS_API_KEY=
COMMAS_WEBHOOK_SECRET=
COMMAS_ENVIRONMENT=sandbox
COMMAS_LIVE_CHARGES=false
# COMMAS_CREATOR_HANDLE=

# --- GHL / LeadConnector (already in Cursor env — copy into Vercel) ---
GHL_API_KEY=
GHL_LOCATION_ID=

# --- Deploy tooling (Cursor agent / CI — not required inside the Next.js runtime) ---
# VERCEL_TOKEN=
# VERCEL_ORG_ID=
# VERCEL_PROJECT_ID=

# --- Desktop download buttons (set only after signed/unsigned release assets exist) ---
# GC_DESKTOP_RELEASES_URL=https://github.com/iamcgrant/Grants-co-os/releases
# GC_DESKTOP_MAC_URL=
# GC_DESKTOP_WIN_URL=
# GC_DESKTOP_LINUX_URL=
