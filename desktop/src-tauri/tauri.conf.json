{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Grants & Co OS",
  "version": "0.1.0",
  "identifier": "com.grantsandco.os",
  "build": {
    "frontendDist": "../public-desktop",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "",
    "beforeBuildCommand": "node ../scripts/prepare-desktop-shell.mjs"
  },
  "app": {
    "windows": [
      {
        "title": "Grants & Co OS",
        "width": 1280,
        "height": 840,
        "minWidth": 980,
        "minHeight": 640,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "nsis", "appimage", "deb"],
    "icon": ["icons/icon.png"],
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "REPLACE_WITH_TAURI_UPDATER_PUBKEY",
      "endpoints": [
        "https://releases.grantsandco.com/desktop/{{target}}/{{current_version}}"
      ]
    }
  }
}
