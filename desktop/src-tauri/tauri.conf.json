{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Grants & Co OS",
  "version": "0.1.0",
  "identifier": "com.grantsandco.os",
  "build": {
    "frontendDist": "../public-desktop",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "",
    "beforeBuildCommand": "node ../scripts/prepare-desktop-shell.mjs"
  },
  "app": {
    "windows": [
      {
        "title": "Grants & Co OS",
        "width": 1280,
        "height": 840,
        "minWidth": 980,
        "minHeight": 640,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "appimage",
      "deb"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "createUpdaterArtifacts": false
  },
  "plugins": {}
}
