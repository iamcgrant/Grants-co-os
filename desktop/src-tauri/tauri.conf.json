{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Grants & Co OS",
  "version": "0.1.6",
  "identifier": "com.grantsandco.os",
  "build": {
    "frontendDist": "https://os.grantandconsultants.com",
    "devUrl": "https://os.grantandconsultants.com",
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Grants & Co OS",
        "url": "https://os.grantandconsultants.com/login",
        "backgroundColor": "#16161a",
        "width": 1280,
        "height": 840,
        "minWidth": 980,
        "minHeight": 640,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "appimage",
      "deb",
      "dmg",
      "app",
      "nsis",
      "msi"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "createUpdaterArtifacts": false
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["grantscoos"]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDNGMjI4QTY4QURFMjcyMTIKUldRU2N1S3RhSW9pUDBXckJlZGZUWG9ReDNuQWY5OXhPQktENFBlRnBQelBvaUJ4VDNiU1BjMHkK",
      "endpoints": [
        "https://github.com/iamcgrant/Grants-co-os/releases/latest/download/latest.json"
      ]
    }
  }
}
