{
  "name": "grant-co-os",
  "version": "1.0.0",
  "private": true,
  "description": "Grant & Co OS desktop for Grant & Co Consultants",
  "main": "src/main/index.js",
  "author": "Grant & Co Consultants",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.js",
    "helper:fetch": "bash scripts/helper-fetch.sh",
    "helper:build": "bash scripts/helper-build.sh",
    "build:mac": "CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac dir --arm64",
    "dist:mac": "CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac dmg --arm64",
    "smoke": "electron . --smoke"
  },
  "devDependencies": {
    "electron": "^37.2.6",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.grantandconsultants.os",
    "productName": "Grant & Co OS",
    "copyright": "Grant & Co Consultants",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "vendor/NOTICE.md",
      "vendor/platform-imessage.pin.json",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "native/messages-helper/bin",
        "to": "messages-helper",
        "filter": [
          "imessage-cli"
        ]
      }
    ],
    "mac": {
      "target": [
        "dmg",
        "dir"
      ],
      "identity": null,
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "artifactName": "Grant-and-Co-OS-Mac.${ext}",
      "category": "public.app-category.business",
      "extendInfo": {
        "CFBundleIdentifier": "com.grantandconsultants.os"
      },
      "asarUnpack": [
        "**/messages-helper/**"
      ]
    },
    "dmg": {
      "title": "Grant & Co OS",
      "artifactName": "Grant-and-Co-OS-Mac.${ext}"
    }
  }
}
