{
  "name": "grants-co-os-electron-spike",
  "version": "0.0.1",
  "private": true,
  "description": "DISPOSABLE Electron feasibility spike for Grants & Co OS. Not a Tauri replacement. Not a production desktop app.",
  "main": "src/main/index.js",
  "author": "Grants & Co Consultants",
  "scripts": {
    "start": "electron .",
    "smoke": "electron . --smoke",
    "test": "node --test tests/*.test.js",
    "build": "electron-builder --win",
    "build:linux": "electron-builder --linux dir"
  },
  "devDependencies": {
    "electron": "^37.2.6",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.grantandconsultants.os.electron-spike",
    "productName": "GrantsCo OS Electron Spike",
    "copyright": "Grants & Co Consultants",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "target": [
        "dir"
      ]
    }
  }
}
