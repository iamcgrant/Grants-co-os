{
  "name": "grants-co-os-electron-spike",
  "version": "0.0.1",
  "private": true,
  "description": "DISPOSABLE Electron feasibility spike for Grants & Co OS. Not a Tauri replacement. Not a production desktop app.",
  "main": "src/main/index.js",
  "author": "Grants & Co Consultants",
  "scripts": {
    "start": "electron .",
    "smoke": "electron . --smoke",
    "test": "node --test tests/*.test.js",
    "build": "electron-builder --win",
    "build:linux": "electron-builder --linux dir",
    "helper:fetch": "bash scripts/helper-fetch.sh",
    "helper:build": "bash scripts/helper-build.sh"
  },
  "devDependencies": {
    "electron": "^37.2.6",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.grantandconsultants.os.electron-spike",
    "productName": "Grant & Co OS",
    "copyright": "Grants & Co Consultants",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "vendor/NOTICE.md",
      "vendor/platform-imessage.pin.json",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "native/messages-helper/bin",
        "to": "messages-helper",
        "filter": [
          "imessage-cli"
        ]
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "target": [
        "dir"
      ]
    }
  }
}
