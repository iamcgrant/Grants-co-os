// Grants & Co OS — Production PostgreSQL schema (Neon / Supabase via Vercel Marketplace).
// Local Cloud Agent + Vitest continue to use prisma/schema.prisma (sqlite).
// Generate with: DATABASE_URL=postgresql://… node scripts/prisma-generate.mjs

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  OWNER
  ADMIN
  MANAGER
  CUSTOMER_SERVICE
  FILE_PREPARER
  MARKETING
  CLIENT
}

enum BillingPolicyType {
  MANUAL_INVOICE
  AFTER_SERVICE_MILESTONE
  RECURRING_AFTER_MILESTONE
  PAY_PER_COMPLETED_SERVICE
  CUSTOM_CONFIGURABLE_POLICY
}

enum InvoiceStatus {
  DRAFT
  NOT_YET_BILLABLE
  DUE
  PROCESSING
  SUCCEEDED
  FAILED
  CANCELED
  PARTIALLY_REFUNDED
  REFUNDED
  DISPUTED
}

enum TransactionStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
  CANCELED
}

enum SettlementStatus {
  UNSETTLED
  PENDING
  SETTLED
  FAILED
}

enum PayoutStatus {
  NONE
  PENDING
  IN_TRANSIT
  PAID
  FAILED
  CANCELED
}

enum CreditBureau {
  EQUIFAX
  EXPERIAN
  TRANSUNION
}

enum TaskStatus {
  OPEN
  IN_PROGRESS
  BLOCKED
  DONE
  CANCELED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model User {
  id                 String    @id @default(cuid())
  email              String    @unique
  passwordHash       String
  firstName          String
  lastName           String
  role               Role
  isActive           Boolean   @default(true)
  mfaEnabled         Boolean   @default(false)
  mfaSecret          String?
  /** When true, password login is blocked until /set-password completes. */
  mustChangePassword Boolean   @default(false)
  lastLoginAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  staffProfile       StaffProfile?
  client             Client?
  sessions           Session[]
  auditLogs          AuditLog[]           @relation("AuditActor")
  assignedTasks      Task[]               @relation("TaskAssignee")
  createdTasks       Task[]               @relation("TaskCreator")
  clientAssignments  ClientAssignment[]   @relation("StaffAssignments")
  completedMilestones ServiceMilestone[]  @relation("MilestoneCompleter")
  timelineEvents     ClientTimelineEvent[] @relation("TimelineActor")
  conversationParts  ConversationParticipant[]
  messagesSent       Message[]            @relation("MessageSender")
  teamMentions       MessageMention[]
  disputeCases       DisputeCase[]        @relation("DisputeCaseActor")
  mortgageAssignments  MortgageStaffAssignment[]
  mortgageNotes        MortgageApplicationNote[]
  mortgageAuditEvents  MortgageAuditEvent[] @relation("MortgageAuditActor")
  underwritingDecisions UnderwritingDecision[] @relation("UwDecisionActor")
  charlesUwGates       UnderwritingDecision[] @relation("CharlesUwGate")
}

model Session {
  id               String   @id @default(cuid())
  userId           String
  tokenHash        String   @unique
  expiresAt        DateTime
  revokedAt        DateTime?
  userAgent        String?
  ipAddress        String?
  createdAt        DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model StaffProfile {
  id        String   @id @default(cuid())
  userId    String   @unique
  title     String?
  phone     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Client {
  id              String   @id @default(cuid())
  grantsClientId  String   @unique // GC-000001
  userId          String?  @unique
  email           String
  emailNormalized String
  phone           String?
  phoneNormalized String?
  firstName       String
  lastName        String
  status          String   @default("ACTIVE")
  stage           String   @default("NEW_ENROLLMENT")
  nextAction      String?
  nextActionOwner String? // CHARLES | SIMON | JONA | CLIENT | SYSTEM
  urgency         String   @default("NORMAL") // LOW NORMAL HIGH CRITICAL
  lastInteractionAt DateTime?
  nextDueAt       DateTime?
  duplicateFlag   Boolean  @default(false)
  notes           String?
  /// Engine B — consumer lead pipeline. Null when the master is not an acquisition lead.
  acquisitionStage           ConsumerLeadStage?
  /// Command-center source. Null = unknown (never coerced to ORGANIC).
  acquisitionSource          AcquisitionSource?
  /// Partner-attributed consumer leads must carry a locked AcquisitionMarket.
  acquisitionMarket          AcquisitionMarket?
  grantsLeadScore            Int?
  grantsLeadScoreReasonsJson String?
  referredByPartnerId        String?
  doNotContact               Boolean  @default(false)
  unsubscribed               Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user                User?                 @relation(fields: [userId], references: [id])
  conversations       Conversation[]
  onboardingChecklist OnboardingItem[]
  disputeRounds       DisputeRound[]
  disputeCases        DisputeCase[]
  fridayPulseItems    FridayPulseItem[]
  identifiers         ClientIdentifier[]
  addresses           Address[]
  clientServices      ClientService[]
  contracts           Contract[]
  invoices            Invoice[]
  paymentCustomers    PaymentCustomer[]
  paymentMethods      PaymentMethod[]
  paymentTransactions PaymentTransaction[]
  refunds             Refund[]
  paymentDisputes     PaymentDispute[]
  paymentRequests     PaymentRequest[]
  paymentLinks        PaymentLink[]
  onboardingTokens    OnboardingToken[]
  documents           Document[]
  tasks               Task[]
  assignments         ClientAssignment[]
  timelineEvents      ClientTimelineEvent[]
  notifications       Notification[]
  creditConnections   CreditConnection[]
  creditSnapshots     CreditSnapshot[]
  creditScores        CreditScore[]
  creditAccounts      CreditAccount[]
  creditMonitoringEvents CreditMonitoringEvent[]
  conversionEvents    ConversionEvent[]
  leadAttributions    LeadAttribution[]
  automationRuns      AutomationRun[]
  exceptionTickets    ExceptionTicket[]
  referredByPartner   Partner?              @relation("PartnerReferredClients", fields: [referredByPartnerId], references: [id], onDelete: SetNull)
  partnerReferrals    PartnerReferral[]
  sbtpgPayouts        SbtpgPayout[]
  mortgageApplications MortgageApplication[]
  ssnVaults            SsnVault[]

  @@unique([emailNormalized])
  @@index([phoneNormalized])
  @@index([lastName, firstName])
  @@index([acquisitionStage])
  @@index([acquisitionSource])
  @@index([acquisitionMarket])
  @@index([referredByPartnerId])
}

model ClientIdentifier {
  id           String   @id @default(cuid())
  clientId     String
  provider     String // GHL, DISPUTEFOX, CREDIT_REPAIR_CLOUD, SMARTCREDIT, PAYMENT, etc.
  externalId   String
  metadataJson String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([provider, externalId])
  @@index([clientId])
}

/// Official SBTPG payout / refund totals recorded in OS. No scrape.
model SbtpgPayout {
  id             String    @id @default(cuid())
  clientId       String?
  externalId     String?
  amountCents    Int
  currency       String    @default("USD")
  status         String    @default("PAID")
  taxYear        String?
  paidAt         DateTime?
  periodStart    DateTime?
  periodEnd      DateTime?
  source         String    @default("staff_recorded")
  /// dated = real paid date; season_to_date = official Fee Summary total (never a daily split).
  windowKind     String    @default("dated")
  /// PAYOUT | FEE_SUMMARY_PAID | FEE_SUMMARY_UNFUNDED | FCA | AUTO_COLLECT
  bucket         String    @default("PAYOUT")
  taxpayerCount  Int?
  notes          String?
  recordedById   String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  client Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)

  @@index([status, paidAt])
  @@index([clientId])
  @@index([createdAt])
  @@index([externalId])
  @@index([windowKind, bucket])
}

/// Staff-captured official SBTPG dashboard Fee Summary. No scrape. No invented daily split.
model SbtpgFeeSummarySnapshot {
  id                    String   @id @default(cuid())
  taxYear               String
  capturedOn            String
  capturedAt            DateTime
  sourceLabel           String   @default("SBTPG Fee Summary")
  sourceUrl             String?
  paidCents             Int
  paidTaxpayerCount     Int
  unfundedCents         Int
  unfundedTaxpayerCount Int
  fcaCents              Int      @default(0)
  fcaTaxpayerCount      Int      @default(0)
  autoCollectCents      Int      @default(0)
  notes                 String?
  recordedById          String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@unique([taxYear, capturedOn])
  @@index([taxYear, capturedAt])
}

model Address {
  id         String   @id @default(cuid())
  clientId   String
  type       String   @default("PRIMARY")
  line1      String
  line2      String?
  city       String
  state      String
  postalCode String
  country    String   @default("US")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
}

model Service {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  description String?
  basePriceCents Int
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  billingPolicies BillingPolicy[]
  clientServices  ClientService[]
}

model BillingPolicy {
  id              String            @id @default(cuid())
  serviceId       String
  type            BillingPolicyType
  name            String
  configJson      String? // flexible policy configuration
  amountCents     Int?
  isActive        Boolean           @default(true)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  service         Service           @relation(fields: [serviceId], references: [id])
  clientServices  ClientService[]
  milestones      ServiceMilestone[]

  @@index([serviceId])
}

model ClientService {
  id              String   @id @default(cuid())
  clientId        String
  serviceId       String
  billingPolicyId String
  status          String   @default("ACTIVE")
  startedAt       DateTime @default(now())
  endedAt         DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  client        Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  service       Service        @relation(fields: [serviceId], references: [id])
  billingPolicy BillingPolicy  @relation(fields: [billingPolicyId], references: [id])
  milestones    ServiceMilestone[]
  invoices      Invoice[]
  contracts     Contract[]

  @@index([clientId])
  @@index([serviceId])
}

model Contract {
  id              String   @id @default(cuid())
  clientId        String
  clientServiceId String?
  title           String
  status          String   @default("DRAFT")
  signedAt        DateTime?
  documentId      String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  client        Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientService ClientService? @relation(fields: [clientServiceId], references: [id])

  @@index([clientId])
}

model ServiceMilestone {
  id                   String   @id @default(cuid())
  clientServiceId      String
  billingPolicyId      String
  name                 String
  sequence             Int      @default(1)
  isCompleted          Boolean  @default(false)
  completedAt          DateTime?
  completedByUserId    String?
  supportingDocumentId String?
  invoiceEligible      Boolean  @default(false)
  invoiceCreated       Boolean  @default(false)
  paymentEligible      Boolean  @default(false)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  clientService   ClientService @relation(fields: [clientServiceId], references: [id], onDelete: Cascade)
  billingPolicy   BillingPolicy @relation(fields: [billingPolicyId], references: [id])
  completedByUser User?         @relation("MilestoneCompleter", fields: [completedByUserId], references: [id])
  invoices        Invoice[]

  @@index([clientServiceId])
}

model Invoice {
  id                String        @id @default(cuid())
  invoiceNumber     String        @unique // GC-1048
  clientId          String
  clientServiceId   String?
  milestoneId       String?
  status            InvoiceStatus @default(DRAFT)
  amountCents       Int
  amountPaidCents   Int           @default(0)
  currency          String        @default("USD")
  description       String?
  dueAt             DateTime?
  paidAt            DateTime?
  idempotencyKey    String?       @unique
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  client        Client               @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientService ClientService?       @relation(fields: [clientServiceId], references: [id])
  milestone     ServiceMilestone?    @relation(fields: [milestoneId], references: [id])
  items         InvoiceItem[]
  transactions  PaymentTransaction[]
  refunds       Refund[]
  disputes      PaymentDispute[]
  paymentRequests PaymentRequest[]
  paymentLinks  PaymentLink[]

  @@index([clientId])
  @@index([status])
}

model InvoiceItem {
  id          String @id @default(cuid())
  invoiceId   String
  description String
  quantity    Int    @default(1)
  unitCents   Int
  totalCents  Int

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

model PaymentCustomer {
  id                 String   @id @default(cuid())
  clientId           String
  provider           String
  providerCustomerId String
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([provider, providerCustomerId])
  @@index([clientId])
}

model PaymentMethod {
  id                     String   @id @default(cuid())
  clientId               String
  provider               String
  providerPaymentMethodId String
  type                   String // card, ach
  brand                  String?
  last4                  String?
  expMonth               Int?
  expYear                Int?
  isDefault              Boolean  @default(false)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  client       Client               @relation(fields: [clientId], references: [id], onDelete: Cascade)
  transactions PaymentTransaction[]

  @@unique([provider, providerPaymentMethodId])
  @@index([clientId])
}

model PaymentTransaction {
  id                   String            @id @default(cuid())
  clientId             String
  invoiceId            String?
  paymentMethodId      String?
  provider             String
  providerTransactionId String
  idempotencyKey       String            @unique
  amountCents          Int
  currency             String            @default("USD")
  status               TransactionStatus @default(PENDING)
  settlementStatus     SettlementStatus  @default(UNSETTLED)
  payoutStatus         PayoutStatus      @default(NONE)
  failureCode          String?
  failureMessage       String?
  settledAt            DateTime?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  client        Client            @relation(fields: [clientId], references: [id], onDelete: Cascade)
  invoice       Invoice?          @relation(fields: [invoiceId], references: [id])
  paymentMethod PaymentMethod?    @relation(fields: [paymentMethodId], references: [id])
  attempts      PaymentAttempt[]
  refunds       Refund[]
  disputes      PaymentDispute[]
  payouts       Payout[]

  @@unique([provider, providerTransactionId])
  @@index([clientId])
  @@index([invoiceId])
  @@index([status])
}

model PaymentAttempt {
  id            String   @id @default(cuid())
  transactionId String
  attemptNumber Int
  status        String
  providerRawId String?
  errorCode     String?
  errorMessage  String?
  createdAt     DateTime @default(now())

  transaction PaymentTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@unique([transactionId, attemptNumber])
  @@index([transactionId])
}

model Refund {
  id                String   @id @default(cuid())
  clientId          String
  invoiceId         String?
  transactionId     String
  provider          String
  providerRefundId  String
  idempotencyKey    String   @unique
  amountCents       Int
  reason            String?
  status            String   @default("SUCCEEDED")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  client      Client             @relation(fields: [clientId], references: [id], onDelete: Cascade)
  invoice     Invoice?           @relation(fields: [invoiceId], references: [id])
  transaction PaymentTransaction @relation(fields: [transactionId], references: [id])

  @@unique([provider, providerRefundId])
  @@index([clientId])
  @@index([transactionId])
}

model PaymentDispute {
  id                  String   @id @default(cuid())
  clientId            String
  invoiceId           String?
  transactionId       String
  provider            String
  providerDisputeId   String
  amountCents         Int
  reason              String?
  status              String   @default("OPEN")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  client      Client             @relation(fields: [clientId], references: [id], onDelete: Cascade)
  invoice     Invoice?           @relation(fields: [invoiceId], references: [id])
  transaction PaymentTransaction @relation(fields: [transactionId], references: [id])

  @@unique([provider, providerDisputeId])
  @@index([clientId])
}

model Payout {
  id               String   @id @default(cuid())
  transactionId    String?
  provider         String
  providerPayoutId String
  amountCents      Int
  status           PayoutStatus @default(PENDING)
  arrivedAt        DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  transaction PaymentTransaction? @relation(fields: [transactionId], references: [id])

  @@unique([provider, providerPayoutId])
}

model WebhookEvent {
  id              String   @id @default(cuid())
  provider        String
  providerEventId String
  eventType       String
  payloadJson     String
  processedAt     DateTime?
  status          String   @default("RECEIVED")
  errorMessage    String?
  createdAt       DateTime @default(now())

  @@unique([provider, providerEventId])
  @@index([status])
}

model IntegrationConnection {
  id           String   @id @default(cuid())
  provider     String   @unique
  status       String   @default("MOCK")
  configJson   String?
  lastSyncAt   DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  syncEvents IntegrationSyncEvent[]
}

model IntegrationSyncEvent {
  id           String   @id @default(cuid())
  connectionId String
  direction    String // inbound, outbound
  entityType   String
  externalId   String?
  status       String
  payloadJson  String?
  errorMessage String?
  createdAt    DateTime @default(now())

  connection IntegrationConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@index([connectionId])
}

model Document {
  id             String    @id @default(cuid())
  clientId       String
  name           String
  mimeType       String
  storageKey     String
  category       String?
  uploadedById   String?
  sourceSystem   String? // CREDIT_REPAIR_CLOUD when recovered from CRC
  originalDate   DateTime?
  sourceClientId String? // CRC client ID when sourceSystem=CREDIT_REPAIR_CLOUD
  documentType   String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  mortgageFiles        MortgageDocumentFile[]
  loanConditionDocs    LoanCondition[]

  @@index([clientId])
  @@index([sourceSystem])
}

model Task {
  id           String       @id @default(cuid())
  clientId     String?
  title        String
  description  String?
  status       TaskStatus   @default(OPEN)
  priority     TaskPriority @default(MEDIUM)
  dueAt        DateTime?
  assigneeId   String?
  createdById  String?
  category     String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  client    Client? @relation(fields: [clientId], references: [id], onDelete: Cascade)
  assignee  User?   @relation("TaskAssignee", fields: [assigneeId], references: [id])
  createdBy User?   @relation("TaskCreator", fields: [createdById], references: [id])

  @@index([assigneeId])
  @@index([clientId])
  @@index([status])
}

model ClientAssignment {
  id         String   @id @default(cuid())
  clientId   String
  staffId    String
  roleLabel  String?
  isPrimary  Boolean  @default(false)
  createdAt  DateTime @default(now())

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  staff  User   @relation("StaffAssignments", fields: [staffId], references: [id])

  @@unique([clientId, staffId])
}

model ClientTimelineEvent {
  id          String   @id @default(cuid())
  clientId    String
  actorId     String?
  eventType   String
  title       String
  description String?
  metadataJson String?
  idempotencyKey String? @unique
  createdAt   DateTime @default(now())

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  actor  User?  @relation("TimelineActor", fields: [actorId], references: [id])

  @@index([clientId, createdAt])
  @@index([eventType])
}

model Notification {
  id        String   @id @default(cuid())
  clientId  String?
  userId    String?
  channel   String   @default("IN_APP")
  title     String
  body      String
  status    String   @default("PENDING")
  sentAt    DateTime?
  createdAt DateTime @default(now())

  client Client? @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([userId])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  entityType String
  entityId   String?
  metadataJson String?
  ipAddress  String?
  createdAt  DateTime @default(now())

  actor User? @relation("AuditActor", fields: [actorId], references: [id])

  @@index([entityType, entityId])
  @@index([createdAt])
}

model SystemEvent {
  id        String   @id @default(cuid())
  kind      String
  payloadJson String?
  createdAt DateTime @default(now())

  @@index([kind])
}

model CreditConnection {
  id             String   @id @default(cuid())
  clientId       String
  provider       String // SMARTCREDIT, CREDIT_KARMA, EXPERIAN
  status         String   @default("DISCONNECTED")
  externalId     String?
  lastSyncedAt   DateTime?
  needsReauth    Boolean  @default(false)
  // Encrypted credential reference — never expose to staff UI
  credentialRef  String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([clientId, provider])
  @@index([provider])
}

model CreditSnapshot {
  id         String   @id @default(cuid())
  clientId   String
  source     String
  capturedAt DateTime @default(now())
  summaryJson String?
  createdAt  DateTime @default(now())

  client Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  scores CreditScore[]

  @@index([clientId, capturedAt])
}

model CreditScore {
  id            String       @id @default(cuid())
  clientId      String
  snapshotId    String?
  bureau        CreditBureau
  score         Int
  scoringModel  String
  source        String
  capturedAt    DateTime     @default(now())
  createdAt     DateTime     @default(now())

  client   Client          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  snapshot CreditSnapshot? @relation(fields: [snapshotId], references: [id])

  @@index([clientId, bureau, capturedAt])
  @@index([scoringModel])
}

model CreditChange {
  id           String   @id @default(cuid())
  clientId     String
  bureau       CreditBureau
  previousScore Int?
  newScore     Int
  scoringModel String
  source       String
  changeAmount Int
  detectedAt   DateTime @default(now())

  @@index([clientId, detectedAt])
}

model CreditAccount {
  id           String   @id @default(cuid())
  clientId     String
  bureau       CreditBureau?
  creditorName String
  accountType  String?
  status       String?
  balanceCents Int?
  source       String
  externalId   String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
}

model CreditMonitoringEvent {
  id        String   @id @default(cuid())
  clientId  String
  provider  String
  eventType String
  payloadJson String?
  createdAt DateTime @default(now())

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
}

model MarketingSource {
  id        String   @id @default(cuid())
  name      String   @unique
  platform  String?
  createdAt DateTime @default(now())

  campaigns MarketingCampaign[]
  leads     LeadSource[]
}

model MarketingCampaign {
  id        String   @id @default(cuid())
  sourceId  String
  name      String
  contentId String?
  costCents Int      @default(0)
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  source           MarketingSource   @relation(fields: [sourceId], references: [id])
  leads            LeadSource[]
  conversionEvents ConversionEvent[]

  @@index([sourceId])
}

model LeadSource {
  id          String   @id @default(cuid())
  sourceId    String?
  campaignId  String?
  email       String?
